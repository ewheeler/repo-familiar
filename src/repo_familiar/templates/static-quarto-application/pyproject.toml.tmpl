[build-system]
requires = ["setuptools>=75"]
build-backend = "setuptools.build_meta"

[project]
name = "$project_slug"
version = "0.1.0"
description = "$project_description"
requires-python = ">=3.13,<3.14"
dependencies = [
  "apache-hamilton>=1.89",
  "fastapi[standard]>=0.136",
  "playwright>=1.54",
  "polars>=1.0",
  "pydantic>=2.0",
  "structlog>=25.0",
]

[dependency-groups]
dev = [
  "httpx2>=0.1",
  "mypy>=1.15",
  "pre-commit>=4.0",
  "pytest>=8.0",
  "ruff>=0.11",
]

[project.scripts]
reproduce = "$python_package.reproduce:main"

[tool.setuptools.packages.find]
where = ["src"]

[tool.setuptools.package-data]
"$python_package" = ["py.typed"]

[tool.pytest.ini_options]
testpaths = ["tests"]
addopts = "-m 'not browser'"
markers = ["browser: rendered Static Quarto Application browser flow"]

[tool.ruff]
line-length = 100
target-version = "py313"

[tool.ruff.lint]
select = ["E", "F", "I", "B", "UP"]

[tool.mypy]
python_version = "3.13"
strict = true
packages = ["$python_package"]

[[tool.mypy.overrides]]
module = ["hamilton", "hamilton.*"]
ignore_missing_imports = true
