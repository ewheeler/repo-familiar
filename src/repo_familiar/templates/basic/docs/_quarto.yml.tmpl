project:
  type: website
  output-dir: _site
  render:
    - index.qmd
    - tutorials.qmd
    - how-to.qmd
    - reference.qmd
    - explanation.qmd
    - usage.qmd
    - architecture.qmd

website:
  title: "$project_name"
  description: "$project_description"
  navbar:
    left:
      - href: index.qmd
        text: Home
      - href: tutorials.qmd
        text: Tutorials
      - href: how-to.qmd
        text: How-to
      - href: reference.qmd
        text: Reference
      - href: explanation.qmd
        text: Explanation
      - href: usage.qmd
        text: Usage
      - href: architecture.qmd
        text: Architecture
  sidebar:
    style: docked
    contents:
      - index.qmd
      - section: Documentation System
        contents:
          - tutorials.qmd
          - how-to.qmd
          - reference.qmd
          - explanation.qmd
      - usage.qmd
      - architecture.qmd

format:
  html:
    theme: cosmo
    toc: true
    code-copy: true
