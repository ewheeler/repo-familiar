name: ci

on:
  pull_request:
  push:

jobs:
  validate:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - uses: astral-sh/setup-uv@v7
        with:
          enable-cache: true
      - uses: quarto-dev/quarto-actions/setup@v2
      - run: uv sync --frozen$application_sync_extra
      - run: uv run ruff check .
      - run: uv run ruff format --check .
      - run: uv run mypy
      - run: uv run pytest
      - run: uv run reproduce --check
      - run: quarto render docs
$application_ci_steps
